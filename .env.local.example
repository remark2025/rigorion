# Encrypted Questions Configuration
# Copy to .env.local and update URLs to match your deployment

# Required: URL to the global encrypted manifest
VITE_ENCRYPTED_MANIFEST_URL=https://your-domain.com/content/build/encrypted/manifest.json

# Optional: Base URL for encrypted content (inferred from manifest URL if omitted)
VITE_ENCRYPTED_CONTENT_BASE_URL=https://your-domain.com/content/build

# Required: URL to your deployed Supabase edge function
VITE_SESSION_TOKEN_URL=https://your-project.supabase.co/functions/v1/get-session-token

# For local testing, you can serve content locally:
# VITE_ENCRYPTED_MANIFEST_URL=http://localhost:3000/content/build/encrypted/manifest.json
# VITE_SESSION_TOKEN_URL=http://localhost:54321/functions/v1/get-session-token
{"id":"core","title":"SAT Core Math","description":"Essential algebra and geometry questions","difficulty":"intermediate","category":"math","tags":["algebra","geometry","core"],"questions":[{"id":"CORE-001","type":"multiple_choice","content":"If 3x + 5 = 17, what is the value of x?","options":[{"id":"A","text":"3"},{"id":"B","text":"4"},{"id":"C","text":"5"},{"id":"D","text":"6"}],"correct_answer":"B","explanation":"Solving for x: 3x + 5 = 17, so 3x = 12, therefore x = 4.","difficulty":"beginner","topics":["algebra","linear-equations"],"wordCount":12,"estimatedTime":30,"contentHash":"d66a1e0bc45723393fa59932a7e4b9a0"},{"id":"CORE-002","type":"multiple_choice","content":"A triangle has sides of length 5, 12, and 13. What type of triangle is it?","options":[{"id":"A","text":"Acute"},{"id":"B","text":"Right"},{"id":"C","text":"Obtuse"},{"id":"D","text":"Equilateral"}],"correct_answer":"B","explanation":"This is a right triangle because 5² + 12² = 25 + 144 = 169 = 13².","difficulty":"intermediate","topics":["geometry","triangles","pythagorean-theorem"],"wordCount":16,"estimatedTime":30,"contentHash":"367302285e6a210f6a4b73f1cdcaa1ba"},{"id":"CORE-003","type":"multiple_choice","content":"If f(x) = 2x² - 3x + 1, what is f(2)?","options":[{"id":"A","text":"3"},{"id":"B","text":"5"},{"id":"C","text":"7"},{"id":"D","text":"9"}],"correct_answer":"A","explanation":"f(2) = 2(2)² - 3(2) + 1 = 2(4) - 6 + 1 = 8 - 6 + 1 = 3.","difficulty":"intermediate","topics":["algebra","functions","polynomials"],"wordCount":11,"estimatedTime":30,"contentHash":"6fb655c39e1716d8b6208b04b0cbf5ad"}],"version":"1.0.0","generatedAt":"2025-08-17T15:56:39.215Z","wordCount":39,"estimatedTime":90}